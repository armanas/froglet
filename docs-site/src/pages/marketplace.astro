---
import StoryLayout from '../layouts/StoryLayout.astro';
import AgentMeta from '../components/AgentMeta.astro';
import '../styles/marketplace.css';
import serviceExamples from '../data/live-services.json';
import { servicesView } from '../data/live-services.mjs';
const exampleView = servicesView(serviceExamples);

const image = {
  src: 'https://froglet.dev/og/marketplace.png',
  width: 1200,
  height: 630,
  type: 'image/png',
  alt: 'Froglet marketplace: registered providers and indexed offers.',
};
---
<StoryLayout title="Explore services · Froglet" description="Discover Froglet services, see what they do and cost, check recent availability, and share a service with your agent." path="/marketplace/" image={image}>
<AgentMeta slot="head" route="marketplace" />
<div class="mkt" data-marketplace-live data-status="pending">
  <header class="mkt-title">
    <div class="mkt-title__text">
      <h1>Explore services</h1>
      <p>Services and offers indexed by the Froglet marketplace, refreshed every 30 seconds. Opening a link does not run or pay for anything.</p>
    </div>
    <div class="search" role="search" aria-label="Marketplace search" data-marketplace-search-form>
      <label class="sr-only" for="marketplace-search">Search services</label>
      <input id="marketplace-search" type="search" placeholder="Search services and providers…" autocomplete="off" spellcheck="false" data-marketplace-search />
      <kbd class="mkt-kbd" aria-hidden="true">/</kbd>
      <output class="search-count" for="marketplace-search" data-marketplace-search-count>Loading</output>
    </div>
  </header>

  {exampleView.arithmetic && exampleView.synthetic && <p class="mkt-message"><a href="/services/">Explore the two free reference experiments</a>: a supplied-program calculation and a selected synthetic catalog. Browse the metadata; execution requires a current individual invitation.</p>}

  <div class="mkt-bar" role="group" aria-label="Catalog status">
    <span class="marketplace-status" data-marketplace-field="refresh" data-status="pending">CHECKING</span>
    <span class="mkt-bar__item mkt-bar__item--snapshot">Snapshot <strong data-marketplace-field="checkedAt">waiting</strong></span>
    <span class="mkt-bar__item" data-marketplace-age>Waiting for the first check</span>
    <span class="mkt-bar__item" data-marketplace-next></span>
    <span class="mkt-bar__spacer"></span>
    <button type="button" class="mkt-btn" data-marketplace-refresh>Refresh now</button>
    <button type="button" class="mkt-btn" data-marketplace-copy-summary>Copy evidence</button>
  </div>
  <p class="mkt-message" data-marketplace-field="message" role="status">Checking for services…</p>
  <noscript><p class="mkt-message">JavaScript is required for current catalog data. Use the Providers JSON and Offers JSON links below.</p></noscript>

  <section class="mkt-kpis" aria-label="Catalog totals">
    <div class="mkt-kpi"><div class="k">Providers</div><div class="v" data-marketplace-field="froglets">—</div><div class="d">indexed identities</div></div>
    <div class="mkt-kpi"><div class="k">Shared services</div><div class="v" data-marketplace-field="sharedServices">—</div><div class="d">published with a share link</div></div>
    <div class="mkt-kpi"><div class="k">Offers</div><div class="v" data-marketplace-field="offers">—</div><div class="d">Sample: <span data-marketplace-field="freeOffers">—</span> free · <span data-marketplace-field="paidOffers">—</span> priced</div></div>
    <div class="mkt-kpi"><div class="k">Recently checked</div><div class="v" data-marketplace-field="recentServices">—</div><div class="d">healthy, unexpired provider check</div></div>
    <div class="mkt-kpi"><div class="k">Receipts in sample</div><div class="v" data-marketplace-field="receipts">—</div><div class="d"><span data-marketplace-field="successRate">—</span> reported success rate</div></div>
    <div class="mkt-kpi"><div class="k">Receipt value</div><div class="v" data-marketplace-field="settledSats">—</div><div class="d">sampled indexed receipt totals</div></div>
  </section>

  <div class="mkt-layout">
    <aside class="mkt-side" aria-label="Filters">
      <fieldset class="mkt-cats" data-marketplace-categories>
        <legend>Browse</legend>
        <label class="mkt-cat"><input type="radio" name="marketplace-category" value="all" checked /><span class="mkt-cat__name">All services</span><span class="mkt-cat__count" data-marketplace-category-count="all">—</span></label>
      </fieldset>
      <fieldset class="mkt-toggles">
        <legend>Show only</legend>
        <label class="mkt-toggle-row"><input type="checkbox" data-marketplace-filter="ready" /><span>Recently checked</span></label>
        <label class="mkt-toggle-row"><input type="checkbox" data-marketplace-filter="free" /><span>Free</span></label>
      </fieldset>
      <p class="mkt-help">“Recently checked” means the marketplace recorded a successful provider check that has not expired. Open a service to verify its details before calling.</p>
    </aside>

    <section class="mkt-main" aria-labelledby="mkt-list-heading">
      <h2 id="mkt-list-heading" class="sr-only">Services</h2>
      <div class="mkt-banner" data-marketplace-banner hidden></div>
      <div class="mkt-table-wrap">
        <table class="mkt-table" data-marketplace-service-list aria-describedby="mkt-scope">
          <thead>
            <tr>
              <th scope="col" class="mkt-col-service"><button type="button" class="mkt-sort" data-sort="name">Service</button></th>
              <th scope="col" class="mkt-col-type"><button type="button" class="mkt-sort" data-sort="category">Type</button></th>
              <th scope="col" class="mkt-col-price"><button type="button" class="mkt-sort" data-sort="price">Price</button></th>
              <th scope="col" class="mkt-col-status" aria-sort="ascending"><button type="button" class="mkt-sort" data-sort="status">Status</button></th>
              <th scope="col" class="mkt-col-action"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="mkt-skeleton-rows" aria-hidden="true">
            <tr><td colspan="5"><span class="mkt-skeleton"></span></td></tr>
            <tr><td colspan="5"><span class="mkt-skeleton"></span></td></tr>
            <tr><td colspan="5"><span class="mkt-skeleton"></span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="service-empty" data-marketplace-no-results hidden>
        <p>No services match. Try another search or show all services.</p>
        <button type="button" class="mkt-btn" data-marketplace-reset>Show all services</button>
      </div>
      <p class="mkt-scope" id="mkt-scope" data-marketplace-field="scope">Loading the catalog…</p>
    </section>
  </div>

  <section class="mkt-panels" aria-label="Catalog breakdown">
    <div class="panel panel--table">
      <div class="panel-head"><h2>Providers by reported receipts</h2><button type="button" class="mkt-btn" data-marketplace-copy-provider>Copy top provider</button></div>
      <table class="providers">
        <thead><tr><th scope="col">Identity</th><th scope="col">Endpoint</th><th scope="col">Services</th><th scope="col">OK</th><th scope="col">Fail</th><th scope="col">Receipts</th></tr></thead>
        <tbody data-marketplace-provider-table><tr><td colspan="6" class="panel-empty">Checking catalog…</td></tr></tbody>
      </table>
    </div>
    <div class="mkt-panels__side">
      <div class="panel">
        <div class="panel-head"><h2>Runtimes in offer sample</h2></div>
        <div class="svc-break" data-marketplace-services-breakdown></div>
      </div>
      <div class="panel">
        <div class="panel-head"><h2>Catalog source</h2></div>
        <div class="panel-body">
          <p>Read from <code class="inline">marketplace.froglet.dev</code>.</p>
          <p data-marketplace-field="dealFeedDetail">A public deal feed is not available. Catalog counts do not measure customer activity.</p>
          <nav class="mkt-links" aria-label="Marketplace data">
            <a href="https://marketplace.froglet.dev/v1/providers?limit=12">Providers JSON</a>
            <a href="https://marketplace.froglet.dev/v1/offers?limit=24">Offers JSON</a>
            <a href="/verify-receipt/">Verify receipt</a>
            <a href="/marketplace/overview/">Marketplace docs</a>
          </nav>
        </div>
      </div>
    </div>
  </section>

  <details class="mkt-evidence">
    <summary>Marketplace evidence and technical details</summary>
    <p data-marketplace-field="detail">Checking the catalog connection…</p>
    <p>Catalog counts cover all indexed entries. Receipt statistics and prices cover the loaded sample. Receipts are provider statements, not independently assessed quality or unique buyers.</p>
    <div class="panel panel--table">
      <div class="panel-head"><h2>Indexed offers · up to 24</h2></div>
      <table class="providers offer-book">
        <thead><tr><th scope="col">Offer</th><th scope="col">Runtime</th><th scope="col">Settlement</th><th scope="col">Base + success fee (msat)</th><th scope="col">Provider</th></tr></thead>
        <tbody data-marketplace-offer-book><tr><td colspan="5" class="panel-empty">Checking catalog…</td></tr></tbody>
      </table>
    </div>
  </details>
</div>
</StoryLayout>
<script>
  import { initMarketplaceLive } from '../scripts/marketplace-live';
  initMarketplaceLive();
</script>
