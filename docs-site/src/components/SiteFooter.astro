---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<footer class:list={['site-ftr', compact && 'site-ftr--compact']}>
	<div class="inner">
		<div class="col brand-col">
			<div class="brand" style="align-items: baseline;">
				<span class="mark" style="font-size: 1.2rem;">_o..o_</span>
				froglet
			</div>
			<p>
				Share useful data and tools. Apache-2.0 licensed.<br />
				Built by <a class="author-link" href="https://armanas.dev" target="_blank" rel="noopener">Armanas</a>.
			</p>
		</div>
		<div class="col">
			<h2>Product</h2>
                <a href="/publish/">Start sharing</a>
				<a href="/marketplace/">Explore services</a>
				<a href="/managed/">For organizations</a>
				<a href="/verify-receipt/">Inspect a signed record</a>
				<a href="/learn/cloud-trial/">Hosted trial status</a>
				<a href="/demo/">Protocol walkthrough</a>
		</div>
		<div class="col">
			<h2>Developers</h2>
			<a href="/open-source/">Open source & tools</a>
			<a href="/docs/">Documentation</a>
			<a href="/spec/kernel/">Kernel spec</a>
			<a href="/spec/service-binding/">Service binding</a>
			<a href="/learn/economics/">Game theory</a>
			<a href="/architecture/overview/">Architecture</a>
		</div>
		<div class="col">
			<h2>Community</h2>
			<a href="https://github.com/armanas/froglet" target="_blank" rel="noreferrer">GitHub ↗</a>
			<a href="https://github.com/armanas/froglet/discussions" target="_blank" rel="noopener">Discussions</a>
			<a href="/learn/quickstart/">Quickstart</a>
			<a href="/marketplace/overview/">Marketplace docs</a>
			<a href="/privacy/">Privacy</a>
			<a href="/terms/">Terms</a>
		</div>
		<div class="end">
			<span>froglet.dev</span>
		</div>
	</div>
</footer>

<style is:global>
	.site-ftr .brand-col p {
		font-size: 0.8rem;
		color: var(--fg3);
		margin: 12px 0 0;
		max-width: 22ch;
		line-height: 1.5;
	}

	.site-ftr .brand-col .author-link {
		display: inline;
		padding: 0;
		font-size: inherit;
		color: var(--fg1);
		text-decoration: none;
	}

	.site-ftr .brand-col .author-link:hover {
		color: var(--frog-400);
	}

	.site-ftr--compact {
		margin-top: 32px;
	}

	@media (max-width: 720px) {
		.site-ftr .inner {
			gap: 24px;
		}
		.site-ftr .end {
			margin-left: 0;
			text-align: left;
		}
	}
</style>
