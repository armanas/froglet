---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<footer class:list={['site-ftr', compact && 'site-ftr--compact']}>
	<div class="inner">
		<div class="col brand-col">
			<div class="brand" style="align-items: baseline;">
				<span class="mark" style="font-size: 1.2rem;">_o..o_</span>
				froglet
			</div>
			<p>
				Open protocol for AI agents. Apache-2.0 licensed.<br />
				Built by <a class="author-link" href="https://armanas.dev" target="_blank" rel="noopener">Armanas</a>.
			</p>
			<div class="alithea-project">
				<span>A project of <a class="alithea-text-link" href="https://alithea-bio.com" target="_blank" rel="noopener">Alithea</a>.</span>
				<a class="alithea-logo-link" href="https://alithea-bio.com" target="_blank" rel="noopener" aria-label="Visit Alithea">
					<img class="alithea-logo" src="/logos/alithea-horizontal-violet.svg" alt="Alithea" width="1374" height="371" decoding="async" />
				</a>
			</div>
		</div>
		<div class="col">
			<h5>Product</h5>
				<a href="/docs/">Docs</a>
				<a href="/marketplace/">Marketplace</a>
				<a href="/verify-receipt/">Verify receipt</a>
				<a href="/learn/cloud-trial/">Try in cloud</a>
				<a href="/demo/">Demo</a>
		</div>
		<div class="col">
			<h5>Protocol</h5>
			<a href="/spec/kernel/">Kernel spec</a>
			<a href="/spec/service-binding/">Service binding</a>
			<a href="/learn/economics/">Game theory</a>
			<a href="/architecture/overview/">Architecture</a>
		</div>
		<div class="col">
			<h5>Community</h5>
			<a href="https://github.com/armanas/froglet" target="_blank" rel="noreferrer">GitHub ↗</a>
			<a href="https://github.com/armanas/froglet/discussions" target="_blank" rel="noopener">Discussions</a>
			<a href="/learn/quickstart/">Quickstart</a>
			<a href="/marketplace/overview/">Marketplace docs</a>
			<a href="/privacy/">Privacy</a>
			<a href="/terms/">Terms</a>
		</div>
		<div class="end">
			<span>froglet.dev</span>
		</div>
	</div>
</footer>

<style is:global>
	.site-ftr .brand-col p {
		font-size: 0.8rem;
		color: var(--fg3);
		margin: 12px 0 0;
		max-width: 22ch;
		line-height: 1.5;
	}

	.site-ftr .brand-col .author-link {
		display: inline;
		padding: 0;
		font-size: inherit;
		color: var(--fg1);
		text-decoration: none;
	}

	.site-ftr .brand-col .author-link:hover {
		color: var(--frog-400);
	}

	.site-ftr .brand-col .alithea-project {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		margin-top: 16px;
		font-size: 0.76rem;
		line-height: 1.4;
		color: var(--fg3);
	}

	.site-ftr .brand-col .alithea-text-link {
		display: inline;
		padding: 0;
		font-size: inherit;
		color: var(--fg1);
		text-decoration: none;
	}

	.site-ftr .brand-col .alithea-text-link:hover {
		color: var(--frog-400);
	}

	.site-ftr .brand-col .alithea-logo-link {
		display: inline-flex;
		padding: 0;
		line-height: 1;
		opacity: 0.92;
		transition: opacity 160ms ease;
	}

	.site-ftr .brand-col .alithea-logo-link:hover {
		opacity: 1;
	}

	.site-ftr .brand-col .alithea-logo {
		display: block;
		width: 142px;
		max-width: 100%;
		height: auto;
	}

	.site-ftr--compact {
		margin-top: 32px;
	}

	@media (max-width: 720px) {
		.site-ftr .inner {
			gap: 24px;
		}
		.site-ftr .end {
			margin-left: 0;
			text-align: left;
		}
	}
</style>
