{
  "name": "docs-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:wasm && node scripts/generate-og.mjs && astro build",
    "preview": "astro preview",
    "preview:workers": "npm run build && wrangler dev",
    "preview:maintenance": "wrangler dev --config wrangler.maintenance.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:site": "npm run build && wrangler deploy --config wrangler.jsonc",
    "astro": "astro",
    "test": "vitest --run",
    "build:verifier": "node scripts/build-verifier.mjs",
    "build:playground": "node scripts/build-playground.mjs",
    "build:wasm": "npm run build:verifier && npm run build:playground",
    "deploy:maintenance": "wrangler deploy --config wrangler.maintenance.jsonc"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/starlight": "^0.42.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "^7.3.5",
    "qrcode-generator": "2.0.4",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.0",
    "assemblyscript": "0.28.20",
    "esbuild": "^0.28.2",
    "jsdom": "^29.0.2",
    "jsqr": "1.4.0",
    "lightningcss": "^1.32.0",
    "satori": "^0.13.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  }
}
